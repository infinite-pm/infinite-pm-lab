parser ::c, validator ::c, layout engine ::c, renderer ::c --> tool role ::c
embedder ::c, site generator ::c, language server ::c, tokenizer ::c --> tool role
harness ::c, union builder ::c, board placer ::c, canvas server ::c --> tool role

command-line tool ::c, Go library ::c, editor extension ::c --> tool form ::c
