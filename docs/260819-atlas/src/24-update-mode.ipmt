# AI agent modes and the harness > Update mode
# ipm-overview:docs/use-cases/agent-modes.md#L351
# 32b3cda0b610d6636b3bbd17b9ddce57b43ec80b

run::a Run the update mode ::e --> update mode ::c, writes the model ::c

apply::a Apply the reviewed branch ::e
  --> embed::a Re-embed the diagrams ::e
  --> validate::a Re-validate ::e
apply, embed, validate --::P--> run

agent::a coding agent ::t --> apply, embed, validate
md-embed ::t --> embed
ipm-validate ::t --> validate
br::a reviewed design branch ::t --> apply
pack::a review pack document ::t --> apply
mainwt::a main worktree ::t --> apply, embed, validate
svg::a committed SVGs ::t --> embed

apply --> reviewed before update ::c

agent --> AI agent ::c
md-embed ::t --> embedder ::c
ipm-validate ::t --> validator ::c
br --> design branch ::c
pack --> review pack ::c
mainwt --> ipm knowledge base ::c
svg --> ipm SVG ::c, output ::c
