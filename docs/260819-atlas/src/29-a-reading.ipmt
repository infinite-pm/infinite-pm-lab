# Explore one graph in the canvas > A reading
# ipm-overview:docs/use-cases/explore-in-canvas.md#L15
# ef1b92d59b7512ac69f84f6910bebca21635b2ee

# The whole reading, and the steps that are part of it.
whole::a Explore a graph in the canvas ::e

open::a Open the canvas ::e
  --> pick::a Select a node ::e
  --> into::a Open a composite ::e
  --> share::a Copy the view URL ::e
open, pick, into, share --::P--> whole

# The tool and what the reader looks at
canvas-server --> open
you::a Canvas reader --> open, pick, into, share
src::a hello.ipmt --> open
st::a the state on screen --> into
link::a the copied URL --> share

canvas-server --> canvas server ::c, renderer ::c
you --> Reader ::c
src --> ipmt text ::c, input ::c
st --> click-path state ::c
link --> permalink ::c
