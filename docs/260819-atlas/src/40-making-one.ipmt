# Read a whole knowledge base on one board > Making one
# ipm-overview:docs/use-cases/read-a-board.md#L15
# 32b3cda0b610d6636b3bbd17b9ddce57b43ec80b

# The whole event, and the steps that are part of it.
whole::a Build a board of a corpus ::e

collect::a Collect the fragments ::e
  --> place::a Place the panels ::e
  --> serve::a Serve the board ::e
collect, place, serve --::P--> whole

# Tools
union::a ipm-graph-union ::t --> collect
atlas-gen ::t --> place
canvas-server ::t --> serve

# Artifacts flowing through
corpus::a the pages of a knowledge base ::t --> collect
art::a board.ipma.json ::t --> collect, place, serve
page::a the board page ::t --> serve

# The person
dev::a Corpus keeper ::t --> collect, serve

# What the things are (glossary concepts)
union --> union builder ::c, command-line tool ::c
atlas-gen ::t --> board placer ::c, command-line tool ::c
canvas-server ::t --> canvas server ::c, renderer ::c
corpus --> ipm knowledge base ::c
art --> board artifact ::c, intermediate ::c
page --> board page ::c, output ::c
dev --> Maintainer ::c
